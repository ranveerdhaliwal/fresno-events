# Copy to .dev.vars (same folder) for `pnpm dev` inside apps/api or `pnpm dev:api` from repo root.
# For env-scoped runs:
#   `wrangler dev --env dev`  -> loads .dev.vars.dev  (fall back to .dev.vars)
#   `wrangler dev --env prod` -> loads .dev.vars.prod (fall back to .dev.vars)
# All variants are gitignored. Never commit real secrets.

# Single origin for the local Vite dev server (see scripts/dev-ports.env).
# For multi-origin (e.g. localhost + production domain), set ALLOWED_ORIGINS
# instead with a comma-separated list. ALLOWED_ORIGINS takes precedence when set.
# Use both hostnames — Vite may be opened as localhost or 127.0.0.1 (see scripts/dev-ports.env).
ALLOWED_ORIGINS=http://127.0.0.1:5182,http://localhost:5182
# ALLOWED_ORIGIN=http://localhost:5182

# Supabase — use repo-root dev-target.env + `pnpm env:local` or `pnpm env:cloud-dev`.
# Or set manually (must match workers/ingest/.dev.vars):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: anon works for reads if RLS allows your queries (service role is simpler for local dev)
# SUPABASE_ANON_KEY=

# Required for /review/* routes
ADMIN_REVIEW_TOKEN=

# Optional: when unset the API serves images at /images/<key>; in production set to your
# public R2 base URL (e.g. https://images.whatupfresno.com)
R2_PUBLIC_BASE_URL=
