# Copy to .dev.vars in this folder for `pnpm ingest:dev` (top-level profile).
# For env-scoped runs:
#   `wrangler dev --env dev`  -> loads .dev.vars.dev  (fall back to .dev.vars)
#   `wrangler dev --env prod` -> loads .dev.vars.prod (fall back to .dev.vars)
# All variants are gitignored. Never commit real secrets.

APP_ENV=local
USER_AGENT=WhatUpFresnoBot/0.1 (contact: admin@whatupfresno.com)

# Required to persist candidates and read event_sources
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required to allow POST /trigger
ADMIN_REVIEW_TOKEN=

# Per-source secrets (only needed if that source is enabled)
TICKETMASTER_API_KEY=
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=
EVENTBRITE_API_KEY=
BANDSINTOWN_APP_ID=
ANTHROPIC_API_KEY=

# Gemini (Developer API / AI Studio). Server-side only — never use VITE_*.
# GOOGLE_APPLICATION_CREDENTIALS / service account JSON is NOT required for this path;
# use that only for separate GCP client libraries (Vertex, TTS, etc.).
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Optional: workers_ai | gemini | anthropic (per-role overrides below)
# AI_TEXT_PROVIDER=gemini
# AI_TEXT_PROVIDER_ENRICHMENT=gemini
# AI_TEXT_PROVIDER_DISCOVERY=workers_ai
# GEMINI_MODEL=gemini-2.5-flash
