# Copy to dev-target.env (gitignored). Edit ONLY this file for local dev secrets.
#
#   pnpm env:local       → regenerates apps/api + workers/ingest .dev.vars (local Supabase)
#   pnpm env:cloud-dev   → same (cloud dev Supabase)
#   pnpm env:cloud-prod  → production (use with care)
#   pnpm env:status      → active target + sync check
#
# .dev.vars files are AUTO-GENERATED — do not edit them by hand.

# Active target: local | cloud-dev | cloud-prod
DEV_TARGET=cloud-dev

# --- Supabase (per target) ---
# Local — from `pnpm db:status` after `pnpm db:start`
SUPABASE_URL_LOCAL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY_LOCAL=

# Cloud dev — Project Settings → API (ref mrfkpvbvgzbtcutulfnc)
SUPABASE_URL_CLOUD_DEV=https://mrfkpvbvgzbtcutulfnc.supabase.co
SUPABASE_SERVICE_ROLE_KEY_CLOUD_DEV=

# Cloud prod — fill when ready; never point ingest at prod without intent
SUPABASE_URL_CLOUD_PROD=
SUPABASE_SERVICE_ROLE_KEY_CLOUD_PROD=

# Postgres password ONLY for pnpm db:push-cloud-dev (Dashboard → Database, not service role)
SUPABASE_DB_PASSWORD_CLOUD_DEV=
# Optional: session pooler host (IPv4). Auto-read from supabase/.temp/pooler-url after `supabase link`.
# SUPABASE_DB_POOLER_HOST_CLOUD_DEV=aws-1-us-west-1.pooler.supabase.com

# --- Shared (both workers) ---
ADMIN_REVIEW_TOKEN=

# --- API worker (apps/api) ---
# Must match scripts/dev-ports.env (FRESNO_WEB_PORT). Both hostnames — Vite may use either.
ALLOWED_ORIGINS=http://127.0.0.1:5182,http://localhost:5182
# R2_PUBLIC_BASE_URL=
# Google Maps Platform (one key, API-restricted): Geocoding, Weather, Air Quality, Pollen,
# Time Zone, Geolocation, Address Validation. Server-side only (API worker). Without this, geocode uses Nominatim.
# GOOGLE_MAPS_PLATFORM_API_KEY=

# --- Ingest worker (workers/ingest) ---
# Leave empty to default from DEV_TARGET: local→local, cloud-dev→dev, cloud-prod→production
APP_ENV=
USER_AGENT=WhatUpFresnoBot/0.1 (contact: hello@whatupfresno.com)

VISIT_FRESNO_API_TOKEN=
DOWNTOWN_FRESNO_API_KEY=

GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
MAX_PAGES_PER_SEED=5
MAX_CRAWL_DEPTH=2

# Optional ticketing (only if that scraper is enabled)
# TICKETMASTER_API_KEY=          # Consumer Key only (no Consumer Secret)
# SEATGEEK_CLIENT_ID=
# SEATGEEK_CLIENT_SECRET=
# EVENTBRITE_API_KEY=            # legacy manual-only scraper; prefer venunite for EB overlap
# BANDSINTOWN_APP_ID=

# Optional LLM / ingest overrides
# AI_TEXT_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.5-flash
# INGEST_SKIP_VALIDATION=true
# INGEST_CROSS_SOURCE_DEDUPE=false  # default on; set false for shadow mode — docs/CROSS_SOURCE_DEDUPE.md

# Schema (no data wipe):
#   pnpm db:migrate              # uses DEV_TARGET above (local = migration up --local)
#   pnpm db:migrate:cloud-dev    # linked project pending migrations
#   pnpm db:migrations           # list applied vs repo migrations
