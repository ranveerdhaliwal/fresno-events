# Copy to dev-target.env (gitignored). One toggle drives Supabase for API + ingest.
#
#   pnpm env:local       → local Postgres (pnpm db:start / db:migrate / db:reset)
#   pnpm env:cloud-dev   → Supabase cloud dev project
#   pnpm env:cloud-prod  → production (use with care)
#   pnpm env:status      → show active target + whether .dev.vars match
#
# Switch target (updates both apps/api and workers/ingest .dev.vars), then restart
# pnpm dev:api + pnpm ingest:dev.

# Active target: local | cloud-dev | cloud-prod
DEV_TARGET=cloud-dev

# Local — from `pnpm db:status` after `pnpm db:start`
SUPABASE_URL_LOCAL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY_LOCAL=

# Cloud dev — Project Settings → API (ref mrfkpvbvgzbtcutulfnc)
SUPABASE_URL_CLOUD_DEV=https://mrfkpvbvgzbtcutulfnc.supabase.co
SUPABASE_SERVICE_ROLE_KEY_CLOUD_DEV=

# Cloud prod — fill when ready; never point ingest at prod without intent
SUPABASE_URL_CLOUD_PROD=
SUPABASE_SERVICE_ROLE_KEY_CLOUD_PROD=

# Cloud Postgres password for pnpm db:push-cloud-dev (Dashboard → Database, not service role key)
SUPABASE_DB_PASSWORD_CLOUD_DEV=

# Schema (no data wipe):
#   pnpm db:migrate              # uses DEV_TARGET above (local = migration up --local)
#   pnpm db:migrate:cloud-dev    # linked project pending migrations
#   pnpm db:migrations           # list applied vs repo migrations
