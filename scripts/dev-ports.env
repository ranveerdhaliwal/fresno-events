# Fresno Events local dev ports (edit here to change the whole stack).
#
# Web UI:  http://127.0.0.1:5182  (same from Windows Chrome via WSL localhost forward)
# API:     http://127.0.0.1:8790/health
#
# If curl to 127.0.0.1:5182 fails while Vite says "ready", restart after vite.config
# change, then: ss -tlnp | grep 5182  (must show LISTEN on 127.0.0.1:5182)
#
# Avoids Vite default 5173 and common Wrangler 8787 so other local apps can use those.

FRESNO_WEB_PORT=5182
FRESNO_API_PORT=8790
